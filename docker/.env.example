# Cloudflare Tunnel(cloudflared)のトークン。
# Zero Trust → Networks → Tunnels で named tunnel を作成した際に発行される値を貼る。
#
# 使い方:
#   cp docker/.env.example docker/.env
#   # docker/.env の値を実トークンに差し替える(このファイル自体はコミットしない)
#   docker compose --env-file docker/.env -f docker/docker-compose.yml --profile tunnel up -d
#
# 注意: トークンは機密情報。docker/.env は .gitignore 済みなのでコミットされない。
CLOUDFLARE_TUNNEL_TOKEN=

# Grafana の admin パスワード。
# 注意: grafana-data volume の初回初期化時にのみ反映されるため、初回 up -d の前に docker/.env を用意すること。
# 初回以降に変更する場合: docker compose exec grafana grafana cli admin reset-admin-password <新パスワード>
GRAFANA_ADMIN_PASSWORD=

# Grafana のルート URL。ローカルは未設定でよい(既定 http://localhost:3001)。
# Cloudflare Tunnel で公開する場合は https://grafana.<ドメイン> を設定する。
GRAFANA_ROOT_URL=
