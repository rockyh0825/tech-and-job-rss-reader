{
  "uid": "rss-watch",
  "title": "RSS Watch",
  "description": "rss-watch アプリのエンドポイント性能・JVM・HikariCP・Kafka リスナーの観測ダッシュボード(provisioning でリポジトリ管理)",
  "tags": ["rss-watch"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "uri",
        "label": "URI",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "query": "label_values(http_server_requests_seconds_count, uri)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "エンドポイント別レイテンシ p50/p95/p99(/api/stream 除外)",
      "description": "SSE の /api/stream は接続寿命が duration として記録されレイテンシを汚すため除外している",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 5, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri!=\"/api/stream\", uri=~\"$uri\"}[5m])))",
          "legendFormat": "{{uri}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri!=\"/api/stream\", uri=~\"$uri\"}[5m])))",
          "legendFormat": "{{uri}} p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri!=\"/api/stream\", uri=~\"$uri\"}[5m])))",
          "legendFormat": "{{uri}} p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "エンドポイント別リクエストレート",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 5, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"$uri\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "エラー率(5xx 比率)",
      "description": "5xx が一度も発生していない期間は分子の系列が存在せず空になるため or vector(0) で 0 として描画する",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m])) or vector(0)",
          "legendFormat": "5xx 比率"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM ヒープ",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\"} > 0)",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HikariCP コネクションプール",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "fillOpacity": 5, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_pending",
          "legendFormat": "pending"
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_max",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Kafka リスナー処理レート",
      "description": "spring.kafka.listener タイマーによるリスナー呼び出し数のレート。name はコンテナ名(sink-0 / live-0)。sink はバッチリスナーのため 1 呼び出し = 1 バッチ",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": { "fillOpacity": 5, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(spring_kafka_listener_seconds_count[5m]))",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Kafka リスナー平均処理時間",
      "description": "spring.kafka.listener タイマーの sum/count による平均。sink はバッチリスナーのため 1 呼び出し = 1 バッチの処理時間",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "fillOpacity": 5, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(spring_kafka_listener_seconds_sum[5m])) / sum by (name) (rate(spring_kafka_listener_seconds_count[5m]))",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
